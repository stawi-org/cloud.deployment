# Copy to secrets.identity.local.env (NEVER commit), fill values, chmod 600.
# Then:
#   ./scripts/seed-gcp-secrets.sh \
#     --app identity-authentication \
#     --env stawi-prod \
#     --from-env-file ./secrets.identity.local.env
#
# Or generate random crypto material for empty keys:
#   ./scripts/seed-gcp-secrets.sh --app identity-oauth2-hydra --env stawi-prod \
#     --from-env-file ./secrets.identity.local.env --generate-missing

# --- Deploy-time (CI Neon provider) ---
neon-org-api-key=

# --- Shared ---
hydra-webhook-psk=

# --- identity-authentication ---
identity-authentication-google-oauth-client-id=
identity-authentication-google-oauth-client-secret=
identity-authentication-csrf-secret=
identity-authentication-cookie-hash-key=
identity-authentication-cookie-block-key=

# --- identity-oauth2-hydra ---
identity-oauth2-hydra-secrets-system=
identity-oauth2-hydra-secrets-cookie=

# DATABASE_URL secrets are created by OpenTofu from Neon — do not set here unless overriding.
