# Crypto material for SM — generated by OpenTofu.
#
# WEBHOOK_SECRET_KEY seals shop webhook secrets at rest (AES-256-GCM): the
# service decodes it as base64 of 32 bytes. random_bytes is stable in state,
# so applies never rotate it; rotating it means shops re-enter their webhook
# secrets.
resource "random_bytes" "webhook_secret_key" {
  length = 32
}

locals {
  generated_secret_values = {
    "platform-commerce-webhook-secret-key" = random_bytes.webhook_secret_key.base64
  }
}
