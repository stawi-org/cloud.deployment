{
  "version": 1,
  "description": "Worker: api.stawi.org only. All oauth2*/authz*/accounts: CF orange CNAME → Cloud Run (no Google LB). Stable DNS; switch backends by changing origin. See docs/STABLE_DNS.md.",
  "hostname": "api.stawi.org",
  "region": "europe-west1",
  "gateway": {
    "health_path": "/_gateway/health",
    "routes_path": "/_gateway/routes",
    "docs_path": "/_gateway/docs",
    "hub_paths": ["/", "/docs"],
    "expose_route_list": true,
    "scalar": {
      "theme": "default",
      "dark_mode": true,
      "title": "Stawi API",
      "cdn": "https://cdn.jsdelivr.net/npm/@scalar/api-reference"
    }
  },
  "origin_allowlist": {
    "host_suffixes": [
      ".a.run.app",
      ".run.app"
    ],
    "extra_hosts": []
  },
  "host_routes": [],
  "direct_cnames": [
    {
      "id": "accounts",
      "hostname": "accounts.stawi.org",
      "origin": "https://identity-authentication-akpnezytka-od.a.run.app",
      "protocol": "http",
      "notes": "Login UI. CF CNAME → Cloud Run."
    },
    {
      "id": "oauth2",
      "hostname": "oauth2.stawi.org",
      "origin": "https://identity-oauth2-hydra-akpnezytka-od.a.run.app",
      "protocol": "http",
      "notes": "OIDC public. CF CNAME → Cloud Run."
    },
    {
      "id": "oauth2-w",
      "hostname": "oauth2-w.stawi.org",
      "origin": "https://identity-oauth2-hydra-admin-akpnezytka-od.a.run.app",
      "protocol": "http",
      "notes": "Hydra admin (IAM). CF CNAME → Cloud Run; callers send Google ID token."
    },
    {
      "id": "authz",
      "hostname": "authz.stawi.org",
      "origin": "https://identity-authorization-keto-read-akpnezytka-od.a.run.app",
      "protocol": "grpc",
      "notes": "Keto read gRPC (IAM). Needs CF Host rewrite (Origin Rules); not Worker-fallbackable."
    },
    {
      "id": "authz-w",
      "hostname": "authz-w.stawi.org",
      "origin": "https://identity-authorization-keto-write-akpnezytka-od.a.run.app",
      "protocol": "grpc",
      "notes": "Keto write gRPC (IAM). Needs CF Host rewrite (Origin Rules); not Worker-fallbackable."
    }
  ],
  "routes": [
    {
      "id": "profile",
      "prefix": "/profile",
      "service": "identity-profile",
      "project": "stawi-identity",
      "origin": "https://identity-profile-akpnezytka-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Profile",
        "description": "Contacts, addresses, roster, verification (Connect RPC).",
        "openapi_path": "/openapi.yaml",
        "default": true
      }
    },
    {
      "id": "tenancy",
      "prefix": "/tenancy",
      "service": "identity-tenancy",
      "project": "stawi-identity",
      "origin": "https://identity-tenancy-akpnezytka-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": false,
        "title": "Tenancy",
        "openapi_path": "/openapi.yaml"
      },
      "notes": "Path only (api.stawi.org/tenancy). allUsers invoker + app OAuth; Connect S2S cannot dual-auth."
    },
    {
      "id": "identity",
      "prefix": "/identity",
      "service": "identity-identity",
      "project": "stawi-identity",
      "origin": "https://identity-identity-akpnezytka-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Identity",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "devices",
      "prefix": "/devices",
      "service": "platform-devices",
      "project": "stawi-platform",
      "origin": "https://platform-devices-diujdvkz4a-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Devices",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "settings",
      "prefix": "/settings",
      "service": "platform-settings",
      "project": "stawi-platform",
      "origin": "https://platform-settings-diujdvkz4a-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Settings",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "geolocation",
      "prefix": "/geolocation",
      "service": "platform-geolocation",
      "project": "stawi-platform",
      "origin": "https://platform-geolocation-diujdvkz4a-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Geolocation",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "files",
      "prefix": "/files",
      "service": "platform-files",
      "project": "stawi-platform",
      "origin": "https://platform-files-diujdvkz4a-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Files",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "audit",
      "prefix": "/audit",
      "service": "operations-audit",
      "project": "stawi-operations",
      "origin": "",
      "strip_prefix": true,
      "enabled": false,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Audit",
        "openapi_path": "/openapi.yaml"
      },
      "notes": "Enable after: gcloud auth with stawi-operations + npm run refresh-origins (must be *.run.app)."
    },
    {
      "id": "formstore",
      "prefix": "/formstore",
      "service": "operations-formstore",
      "project": "stawi-operations",
      "origin": "",
      "strip_prefix": true,
      "enabled": false,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Formstore",
        "openapi_path": "/openapi.yaml"
      },
      "notes": "Enable after refresh-origins with operations project access."
    },
    {
      "id": "queuestore",
      "prefix": "/queuestore",
      "service": "operations-queuestore",
      "project": "stawi-operations",
      "origin": "",
      "strip_prefix": true,
      "enabled": false,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Queuestore",
        "openapi_path": "/openapi.yaml"
      },
      "notes": "Enable after refresh-origins with operations project access."
    },
    {
      "id": "redirect",
      "prefix": "/redirect",
      "service": "operations-redirect",
      "project": "stawi-operations",
      "origin": "",
      "strip_prefix": true,
      "enabled": false,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Redirect",
        "openapi_path": "/openapi.yaml"
      },
      "notes": "Enable after refresh-origins with operations project access."
    },
    {
      "id": "thesa",
      "prefix": "/thesa",
      "service": "operations-thesa",
      "project": "stawi-operations",
      "origin": "",
      "strip_prefix": true,
      "enabled": false,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Thesa",
        "openapi_path": "/openapi.yaml"
      },
      "notes": "Enable after refresh-origins with operations project access."
    },
    {
      "id": "trustage",
      "prefix": "/trustage",
      "service": "operations-trustage",
      "project": "stawi-operations",
      "origin": "",
      "strip_prefix": true,
      "enabled": false,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Trustage",
        "openapi_path": "/openapi.yaml"
      },
      "notes": "Enable after refresh-origins with operations project access."
    }
  ]
}
