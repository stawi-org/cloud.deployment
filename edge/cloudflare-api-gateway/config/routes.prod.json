{
  "version": 1,
  "description": "Path map for api.stawi.org → Cloud Run. Source of truth for the Worker + Scalar hub. Extend by adding a route; run npm run validate before deploy.",
  "hostname": "api.stawi.org",
  "region": "europe-west9",
  "gateway": {
    "health_path": "/_gateway/health",
    "routes_path": "/_gateway/routes",
    "docs_path": "/_gateway/docs",
    "hub_paths": ["/", "/docs"],
    "expose_route_list": true,
    "scalar": {
      "theme": "default",
      "dark_mode": true,
      "title": "Stawi API",
      "cdn": "https://cdn.jsdelivr.net/npm/@scalar/api-reference"
    }
  },
  "origin_allowlist": {
    "host_suffixes": [
      ".a.run.app",
      ".run.app"
    ],
    "extra_hosts": [
      "profile.stawi.org",
      "tenancy.stawi.org",
      "identity.stawi.org",
      "devices.stawi.org",
      "settings.stawi.org",
      "geolocation.stawi.org",
      "files.stawi.org",
      "audit.stawi.org",
      "formstore.stawi.org",
      "queuestore.stawi.org",
      "redirect.stawi.org",
      "thesa.stawi.org",
      "trustage.stawi.org"
    ]
  },
  "routes": [
    {
      "id": "profile",
      "prefix": "/profile",
      "service": "identity-profile",
      "project": "stawi-identity",
      "origin": "https://identity-profile-akpnezytka-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Profile",
        "description": "Contacts, addresses, roster, verification (Connect RPC).",
        "openapi_path": "/openapi.yaml",
        "default": true
      }
    },
    {
      "id": "tenancy",
      "prefix": "/tenancy",
      "service": "identity-tenancy",
      "project": "stawi-identity",
      "origin": "https://identity-tenancy-akpnezytka-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": false,
      "docs": {
        "enabled": false,
        "title": "Tenancy",
        "openapi_path": "/openapi.yaml",
        "notes": "Not public on Cloud Run IAM; enable in hub when a public OpenAPI path exists."
      },
      "notes": "Cloud Run IAM authenticated (no allUsers)."
    },
    {
      "id": "identity",
      "prefix": "/identity",
      "service": "identity-identity",
      "project": "stawi-identity",
      "origin": "https://identity-identity-akpnezytka-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Identity",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "devices",
      "prefix": "/devices",
      "service": "platform-devices",
      "project": "stawi-platform",
      "origin": "https://platform-devices-diujdvkz4a-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Devices",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "settings",
      "prefix": "/settings",
      "service": "platform-settings",
      "project": "stawi-platform",
      "origin": "https://platform-settings-diujdvkz4a-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Settings",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "geolocation",
      "prefix": "/geolocation",
      "service": "platform-geolocation",
      "project": "stawi-platform",
      "origin": "https://platform-geolocation-diujdvkz4a-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Geolocation",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "files",
      "prefix": "/files",
      "service": "platform-files",
      "project": "stawi-platform",
      "origin": "https://platform-files-diujdvkz4a-od.a.run.app",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Files",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "audit",
      "prefix": "/audit",
      "service": "operations-audit",
      "project": "stawi-operations",
      "origin": "https://audit.stawi.org",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Audit",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "formstore",
      "prefix": "/formstore",
