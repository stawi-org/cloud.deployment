{
  "version": 1,
  "description": "Worker: api.stawi.org only. Browser hosts (pay, accounts) and control-plane: CF orange CNAME \u2192 Cloud Run + Host rewrite (CF Universal SSL; no Google managed cert). Optional domain-mapping DNS overlay for IAM hosts only. See docs/STABLE_DNS.md.",
  "hostname": "api.stawi.org",
  "region": "europe-west1",
  "gateway": {
    "health_path": "/_gateway/health",
    "routes_path": "/_gateway/routes",
    "docs_path": "/_gateway/docs",
    "hub_paths": [
      "/",
      "/docs"
    ],
    "expose_route_list": true,
    "cors": {
      "allow_origins": [
        "*"
      ],
      "allow_credentials": true,
      "notes": "Reflect any Origin so browser SPAs (e.g. opportunities.stawi.org) can call api.stawi.org with Authorization."
    },
    "scalar": {
      "theme": "default",
      "dark_mode": true,
      "title": "Stawi API",
      "cdn": "https://cdn.jsdelivr.net/npm/@scalar/api-reference"
    }
  },
  "origin_allowlist": {
    "host_suffixes": [
      ".a.run.app",
      ".run.app"
    ],
    "extra_hosts": []
  },
  "host_routes": [
    {
      "id": "pay",
      "hostname": "pay.stawi.org",
      "service": "checkout-checkout",
      "origin": "https://checkout-checkout-zbso62lzwq-ew.a.run.app",
      "strip_prefix": false,
      "enabled": true,
      "public": true,
      "notes": "Hosted checkout: CF Universal SSL via this Worker (Host rewrite to run.app). Preferable to Origin Rules when the API token lacks Rulesets edit. No Google managed cert."
    }
  ],
  "direct_cnames": [
    {
      "id": "accounts",
      "hostname": "accounts.stawi.org",
      "origin": "https://identity-authentication-akpnezytka-ew.a.run.app",
      "protocol": "http",
      "notes": "Login UI. CF CNAME \u2192 Cloud Run.",
      "service": "identity-authentication"
    },
    {
      "id": "oauth2",
      "hostname": "oauth2.stawi.org",
      "origin": "https://identity-oauth2-hydra-akpnezytka-ew.a.run.app",
      "protocol": "http",
      "notes": "OIDC public. CF CNAME \u2192 Cloud Run.",
      "service": "identity-oauth2-hydra"
    },
    {
      "id": "oauth2-w",
      "hostname": "oauth2-w.stawi.org",
      "origin": "https://identity-oauth2-hydra-admin-akpnezytka-ew.a.run.app",
      "protocol": "http",
      "notes": "Hydra admin (IAM). CF CNAME \u2192 Cloud Run; callers send Google ID token.",
      "service": "identity-oauth2-hydra-admin"
    },
    {
      "id": "authz",
      "hostname": "authz.stawi.org",
      "origin": "https://identity-authorization-keto-read-akpnezytka-ew.a.run.app",
      "protocol": "grpc",
      "notes": "Keto read gRPC (IAM). Needs CF Host rewrite (Origin Rules); not Worker-fallbackable.",
      "service": "identity-authorization-keto-read"
    },
    {
      "id": "authz-w",
      "hostname": "authz-w.stawi.org",
      "origin": "https://identity-authorization-keto-write-akpnezytka-ew.a.run.app",
      "protocol": "grpc",
      "notes": "Keto write gRPC (IAM). Needs CF Host rewrite (Origin Rules); not Worker-fallbackable.",
      "service": "identity-authorization-keto-write"
    },
    {
      "id": "pay",
      "hostname": "pay.stawi.org",
      "origin": "https://checkout-checkout-zbso62lzwq-ew.a.run.app",
      "protocol": "http",
      "notes": "Hosted checkout UI. CF direct mapping only (orange CNAME \u2192 run.app + Origin Host rewrite). CF Universal SSL \u2014 never Google domain-mapping certs.",
      "service": "checkout-checkout",
      "project": "stawi-payments",
      "edge": "cf_direct"
    }
  ],
