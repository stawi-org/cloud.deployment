      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Formstore",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "queuestore",
      "prefix": "/queuestore",
      "service": "operations-queuestore",
      "project": "stawi-operations",
      "origin": "https://queuestore.stawi.org",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Queuestore",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "redirect",
      "prefix": "/redirect",
      "service": "operations-redirect",
      "project": "stawi-operations",
      "origin": "https://redirect.stawi.org",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Redirect",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "thesa",
      "prefix": "/thesa",
      "service": "operations-thesa",
      "project": "stawi-operations",
      "origin": "https://thesa.stawi.org",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Thesa",
        "openapi_path": "/openapi.yaml"
      }
    },
    {
      "id": "trustage",
      "prefix": "/trustage",
      "service": "operations-trustage",
      "project": "stawi-operations",
      "origin": "https://trustage.stawi.org",
      "strip_prefix": true,
      "enabled": true,
      "public": true,
      "docs": {
        "enabled": true,
        "title": "Trustage",
        "openapi_path": "/openapi.yaml"
      }
    }
  ]
}
